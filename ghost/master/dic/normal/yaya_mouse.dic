//******************************************************************************
// 撫で反応
//******************************************************************************
//------------------------------------------------------------------------------
//撫でる動き（OnMouseMove）を数えて、決まった回数に達するごとに段階的に反応します。
//  StrokeLimit<スコープ><部位>  … 反応する回数（累積）を段階ごとに並べた配列
//  StrokeLoop<スコープ><部位>   … 1 のとき、最後の段階まで行ったあと、同じ回数ごとに最後の反応を繰り返す
//  MouseMove<スコープ><部位>_<段階> … 段階ごとの反応（無ければ MouseMove<スコープ><部位>）
//別の部位に移るか、当たり判定の外に出ると、数え直します
//------------------------------------------------------------------------------
OnMouseMove
{
	if reference[4] == '' {
		//---- 当たり判定の外
		stroke_zone = ''
		stroke_count = 0
		return
	}

	_zone = TOSTR(reference[3]) + reference[4]
	if _zone != stroke_zone {
		//---- 別の部位に移った
		stroke_zone = _zone
		stroke_count = 0
		stroke_phase = 0
		stroke_limits = StrokeLimitOf(_zone)
		return
	}

	stroke_count += 1
	if ARRAYSIZE(stroke_limits) == 0 || stroke_phase < 0 {
		return
	}
	if stroke_count < TOINT(stroke_limits[stroke_phase]) {
		return
	}
	if 'talking' _in_ status {
		return
	}

	//---- 回数に達したので反応する
	_phase = stroke_phase
	_last = ARRAYSIZE(stroke_limits) - 1
	if _phase < _last {
		stroke_phase += 1
	}
	elseif ISFUNC('StrokeLoop' + _zone) {
		stroke_count = 0
	}
	else {
		stroke_phase = -1
	}

	_name = 'MouseMove' + _zone
	if ISFUNC(_name + '_' + TOSTR(_phase)) {
		EVAL(_name + '_' + TOSTR(_phase))
	}
	elseif ISFUNC(_name) {
		EVAL(_name)
	}
}

StrokeLimitOf
{
	_f = 'StrokeLimit' + _argv[0]
	if ISFUNC(_f) {
		SPLIT(EVAL(_f), ',')
	}
	else {
		IARRAY
	}
}

