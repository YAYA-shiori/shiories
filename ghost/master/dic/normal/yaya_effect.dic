//******************************************************************************
// SHIORIES
// 演出（振動・テレポート・切り替え）
// 元の辞書では SAORI の effect.dll（振動）と winpos.dll（窓位置の取得）を使っていました。
// 今は SSP の \![move] タグで代替しています。
//******************************************************************************

//------------------------------------------------------------------------------
//振動：今しゃべっているキャラクターの窓を、細かく左右に揺らす
//オプション設定の「振動機能」で無効にできる
//------------------------------------------------------------------------------
Shake
{
	if option_shake {
		'\![move,--X=12,--time=30,--base=me]\![move,--X=-24,--time=30,--base=me]\![move,--X=24,--time=30,--base=me]\![move,--X=-24,--time=30,--base=me]\![move,--X=24,--time=30,--base=me]\![move,--X=-12,--time=30,--base=me]'
	}
}

//------------------------------------------------------------------------------
//テレポート：今しゃべっているキャラクターの窓を、左右どちらかに150px 動かす
//------------------------------------------------------------------------------
Teleport
{
	_dx = RAND(2) * 300 - 150
	"\![move,--X=%(_dx),--time=0,--base=me]"
}

//------------------------------------------------------------------------------
//ほかのゴーストが入っていれば、ランダムに切り替える。無ければ終了
//------------------------------------------------------------------------------
ChangeGhostOrClose
{
	if ARRAYSIZE(installedghostlist) > 1 {
		'\![change,ghost,random]'
	}
	else {
		'\-'
	}
}
