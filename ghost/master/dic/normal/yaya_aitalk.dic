//******************************************************************************
// 時報・起動時間・重なり（OnMinuteChange）
//******************************************************************************
//------------------------------------------------------------------------------
//OnMinuteChangeイベント
//  1. ゴーストが起動してから1時間経つごとに、起動時間のトーク
//  2. 毎時0分に、時報
//  3. 本体と相方が重なって一定時間経っていれば、重なりのトーク（見切れ中は除く）
//------------------------------------------------------------------------------
OnMinuteChange
{
	//---- ゴースト側で数えた起動時間（時間）
	_hours = (GETSECCOUNT - ghost_boot_sec) / 3600
	_due = 0
	if _hours > worktime {
		worktime = _hours
		_due = 1
	}

	//---- reference[3] が 0 のときはトークを再生できない
	if reference[3] == 1 {
		if _due {
			WorktimeTalk
		}
		elseif minute == 0 {
			ChimeTalk
		}
		elseif reference[1] == 0 && reference[2] == 1 && option_kasanari {
			KasanariTalk
		}
	}
}

//------------------------------------------------------------------------------
// 時報
//------------------------------------------------------------------------------
ChimeTalk
{
	"\p[3]\s[-1]\p[2]\s[2000]\1\s[1000]\0\s[0]%(hour)時です。\w8\e"
}

//------------------------------------------------------------------------------
// 起動時間（1時間経つごとに1回）
//------------------------------------------------------------------------------
//1〜6時間目は個別のトーク、7〜10時間目はShort、11〜14時間目はMiddle、
//15〜19時間目はLong、20時間以上はVerylong
WorktimeTalk
{
	if worktime == 1 {
		Worktime_1st
	}
	elseif worktime == 2 {
		Worktime_2nd
	}
	elseif worktime == 3 {
		Worktime_3rd
	}
	elseif worktime == 4 {
		Worktime_4th
	}
	elseif worktime == 5 {
		Worktime_5th
	}
	elseif worktime == 6 {
		Worktime_6th
	}
	elseif worktime <= 10 {
		Worktime_Short
	}
	elseif worktime <= 14 {
		Worktime_Middle
	}
	elseif worktime <= 19 {
		Worktime_Long
	}
	else {
		Worktime_Verylong
	}
}

Worktime_1st
{
	'\p[3]\s[-1]\p[2]\s[2000]\1\s[1000]\0\s[0]\p[3]\s[3000]おーっほっほっほ！\w8\nまさか１時間程度でヘタるＣＰＵなんて、\w4使ってないでしょうね！？\w8\n\n[half]\0\s[3]…\w8…\w8あなたの場合、\w4そんなレベルじゃないと思うんですが。\w8\n\n[half]\1\s[1155]過負荷♪過負荷♪\w8\w8\n\n[half]\p[2]\s[2001]ＣＰＵ殺し…\w8…\w8\w8\n\n[half]\p[3]\s[3000]な、\w4なんですってぇぇぇ！！\w8\e'
