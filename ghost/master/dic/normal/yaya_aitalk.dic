//******************************************************************************
// 見切れ・サーフェス復帰
//******************************************************************************
//------------------------------------------------------------------------------
//OnSecondChangeイベント
//1 秒毎に実行される。ここではあまり重い処理を行わないこと
//見切れ状態になった／戻ったときに、それぞれトークする
//------------------------------------------------------------------------------
OnSecondChange
{
	if option_mikire {
		if AYATEMPLATE.mikireflag == 0 && reference[1] == 1 {
			MikireTalk
		}
		elseif AYATEMPLATE.mikireflag == 1 && reference[1] == 0 {
			EndMikireTalk
		}
	}
	AYATEMPLATE.mikireflag = reference[1]
}

MikireTalk
{
	'\p[3]\s[-1]\p[2]\s[2000]\1\s[1000]\0\s[4]あのー…\w8…\w8。\w8\e'
}

EndMikireTalk
{
	'\p[3]\s[-1]\p[2]\s[2000]\1\s[1000]\0\s[1]どうも。\w8\n邪魔なら終了してくださいよ。\w8\e'
}

//------------------------------------------------------------------------------
// サーフェス復帰（元の TalkReturn。一定時間たつと表情を初期状態に戻す）
//------------------------------------------------------------------------------
OnSurfaceRestore
{
	'\p[3]\s[-1]\p[2]\s[2000]\1\s[1000]\0\s[0]\e'
}

