//******************************************************************************
// SHIORIES
// ゴースト切り替えのトーク
// 関数名は「イベント名＋_＋相手の\0側の名前」。無ければ「イベント名＋Other」。それも無ければ OnClose / OnBoot のトーク。
// 「イベント名＋Other」では、相手の SHIORI（文・里々・華和梨）を Reference3 のパスから判別して、SHIORI ごとの汎用トークを返す。
//******************************************************************************


//******************************************************************************
// 切り替えの入口
//******************************************************************************
//他のゴーストへ切り替える
OnGhostChanging
{
	MarkClosed
	--
	AYATEMPLATE.ExecuteChangeCallTalk("OnGhostChanging","OnClose")
}

//他のゴーストから切り替わった（自分から自分への切り替え＝再起動もここに来る）
OnGhostChanged
{
	BootStart
	--
	if boot_crashed {
		BootCrashed
	}
	else {
		AYATEMPLATE.ExecuteChangeCallTalk("OnGhostChanged","OnBoot")
	}
}

//他のゴーストから呼び出された
OnGhostCalled
{
	BootStart
	--
	if boot_crashed {
		BootCrashed
	}
	else {
		AYATEMPLATE.ExecuteChangeCallTalk("OnGhostCalled","OnBoot")
	}
}

OnGhostCalling
{
	AYATEMPLATE.ExecuteChangeCallTalk('OnGhostCalling','General_OnGhostCalling')
}

OnGhostCallComplete
{
	AYATEMPLATE.ExecuteChangeCallTalk('OnGhostCallComplete','General_OnGhostCallComplete')
}

OnOtherGhostClosed
{
	AYATEMPLATE.ExecuteChangeCallTalk('OnOtherGhostClosed','General_OnOtherGhostClosed')
}

OnOtherGhostBooted
{
	AYATEMPLATE.ExecuteChangeCallTalk('OnOtherGhostBooted','General_OnOtherGhostBooted')
}

OnOtherGhostChanged
{
	AYATEMPLATE.ExecuteChangeCallTalk('OnOtherGhostChanged')
}


//******************************************************************************
// 相手のゴーストの SHIORI の判別
//******************************************************************************
//ゴーストのパス（Reference3）から、相手を「文」「里々」「華和梨」のどれとして扱うかを返す。判別できなければ空文字列。
//	ghost/master/ に yaya.dll か aya5.dll があれば「文」、satori.dll があれば「里々」、shiori.dll と kawarirc.kis があれば「華和梨」。
//	Reference3 があるのは OnGhostChanging（切り替え先）、OnGhostChanged（直前のゴースト）、OnGhostCalling（呼び出し先）、OnGhostCalled（呼び出し元）。
//_argv[0]	ゴーストのパス（末尾の \ はあってもなくてもよい）
GhostShioriKind
{
	_kind = ''
	_dir = TOSTR(_argv[0])
	if _dir != '' {
		if !RE_SEARCH(_dir,'[\\/]$') {
			_dir += '/'
		}
		_master = _dir + 'ghost/master/'
		if FSIZE(_master + 'yaya.dll') >= 0 || FSIZE(_master + 'aya5.dll') >= 0 {
			_kind = '文'
		}
		elseif FSIZE(_master + 'satori.dll') >= 0 {
			_kind = '里々'
		}
		elseif FSIZE(_master + 'shiori.dll') >= 0 && FSIZE(_master + 'kawarirc.kis') >= 0 {
			_kind = '華和梨'
		}
	}
	_kind
}

//相手の SHIORI ごとの汎用トークを返す。相手が判別できない、またはその SHIORI のトークが無ければ空文字列。
//_argv[0]	種類（Changing / Changed / Calling / Called）。トークは「Ghost＋種類＋.＋文・里々・華和梨」
//_argv[1]	ゴーストのパス（Reference3）
GhostKindTalk
{
	_kind = GhostShioriKind(_argv[1])
	if _kind != '' {
		_funcname = "Ghost%(_argv[0]).%(_kind)"
		if ISFUNC(_funcname) {
			EVAL(_funcname)
		}
	}
}


//******************************************************************************
// 汎用の切り替えトーク
//******************************************************************************
OnGhostChangingOther
{
	_ref0 = SHIORI3FW.EscapeAllTags(reference[0])
	if GhostUpMinutes < 3 {
		BootShort
	}
	else {
		_talk = GhostKindTalk('Changing',reference[3])
		if _talk != '' {
			_talk
		}
		else {
			"\p[3]\s[-1]\p[2]\s[2000]\1\s[1000]\0\s[0]%(_ref0)さんに交代します。\w8\e"

			"\p[3]\s[-1]\p[2]\s[2000]\0\s[0]\1\s[1005]%(_ref0)さんだね。\w8\nちょっと待ってね～。\w8\n\e"

			"\p[3]\s[-1]\1\s[1000]\0\s[0]\p[2]\s[2106]%(_ref0)と交代する…\w8…\w8\e"
		}
	}
}

OnGhostChangedOther
{
	_ref0 = SHIORI3FW.EscapeAllTags(reference[0])
	if 0 <= boot_away_min && boot_away_min < 3 {
		BootShort
	}
	elseif boot_away_min >= 60 * 24 * 30 {
		BootLong
	}
	else {
		_talk = GhostKindTalk('Changed',reference[3])
		if _talk != '' {
			_talk
		}
		else {
			"\p[3]\s[-1]\p[2]\s[2000]\1\s[1000]\0\s[0]%(_ref0)さん、\w4お疲れ様です。\w8\e"

			"\p[3]\s[-1]\p[2]\s[2000]\0\s[0]\1\s[1005]%(_ref0)さーん、\w4お疲れ～\w8\nあとはボクたちがやるよ～\w8\n\e"

			"\p[3]\s[-1]\1\s[1000]\0\s[0]\p[2]\s[2106]%(_ref0)、\w4安らかに眠れ…\w8…\w8。\0\s[208]文ちゃん、\w4それ思いっきり意味違うから。\w8\n\e"
		}
	}
}

//呼び出し先・呼び出し元の SHIORI に応じたトーク。判別できなければ空文字列を返し、汎用のトーク（General_OnGhostCalling / OnBoot のトーク）に回る。
OnGhostCallingOther
{
	GhostKindTalk('Calling',reference[3])
}

OnGhostCalledOther
{
	GhostKindTalk('Called',reference[3])
}

