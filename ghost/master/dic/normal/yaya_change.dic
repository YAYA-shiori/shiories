//******************************************************************************
// SHIORIES
// ゴースト切り替えのトーク
// 関数名は「イベント名＋_＋相手の\0側の名前」。無ければ「イベント名＋Other」。それも無ければ OnClose / OnBoot のトーク。
//******************************************************************************


//******************************************************************************
// 切り替えの入口
//******************************************************************************
//他のゴーストへ切り替える
OnGhostChanging
{
	MarkClosed
	--
	AYATEMPLATE.ExecuteChangeCallTalk("OnGhostChanging","OnClose")
}

//他のゴーストから切り替わった（自分から自分への切り替え＝再起動もここに来る）
OnGhostChanged
{
	BootStart
	--
	if boot_crashed {
		BootCrashed
	}
	else {
		AYATEMPLATE.ExecuteChangeCallTalk("OnGhostChanged","OnBoot")
	}
}

//他のゴーストから呼び出された
OnGhostCalled
{
	BootStart
	--
	if boot_crashed {
		BootCrashed
	}
	else {
		AYATEMPLATE.ExecuteChangeCallTalk("OnGhostCalled","OnBoot")
	}
}

OnGhostCalling
{
	AYATEMPLATE.ExecuteChangeCallTalk('OnGhostCalling','General_OnGhostCalling')
}

OnGhostCallComplete
{
	AYATEMPLATE.ExecuteChangeCallTalk('OnGhostCallComplete','General_OnGhostCallComplete')
}

OnOtherGhostClosed
{
	AYATEMPLATE.ExecuteChangeCallTalk('OnOtherGhostClosed','General_OnOtherGhostClosed')
}

OnOtherGhostBooted
{
	AYATEMPLATE.ExecuteChangeCallTalk('OnOtherGhostBooted','General_OnOtherGhostBooted')
}

OnOtherGhostChanged
{
	AYATEMPLATE.ExecuteChangeCallTalk('OnOtherGhostChanged')
}


//******************************************************************************
// 汎用の切り替えトーク
//******************************************************************************
OnGhostChangingOther
{
	_ref0 = SHIORI3FW.EscapeAllTags(reference[0])
	if GhostUpMinutes < 3 {
		BootShort
	}
	else {
		"\p[3]\s[-1]\p[2]\s[2000]\1\s[1000]\0\s[0]%(_ref0)さんに交代します。\w8\e"
		"\p[3]\s[-1]\p[2]\s[2000]\0\s[0]\1\s[1005]%(_ref0)さんだね。\w8\nちょっと待ってね～。\w8\n\e"
		"\p[3]\s[-1]\1\s[1000]\0\s[0]\p[2]\s[2106]%(_ref0)と交代する…\w8…\w8\e"
	}
}

OnGhostChangedOther
{
	_ref0 = SHIORI3FW.EscapeAllTags(reference[0])
	if 0 <= boot_away_min && boot_away_min < 3 {
		BootShort
	}
	elseif boot_away_min >= 60 * 24 * 30 {
		BootLong
	}
	else {
		"\p[3]\s[-1]\p[2]\s[2000]\1\s[1000]\0\s[0]%(_ref0)さん、\w4お疲れ様です。\w8\e"
		"\p[3]\s[-1]\p[2]\s[2000]\0\s[0]\1\s[1005]%(_ref0)さーん、\w4お疲れ～\w8\nあとはボクたちがやるよ～\w8\n\e"
		"\p[3]\s[-1]\1\s[1000]\0\s[0]\p[2]\s[2106]%(_ref0)、\w4安らかに眠れ…\w8…\w8。\n\n[half]\0\s[208]文ちゃん、\w4それ思いっきり意味違うから。\w8\n\e"
	}
}


//******************************************************************************
// 再起動（自分から自分への切り替え）
//******************************************************************************
OnGhostChanging_華和梨
{
	'\p[3]\s[-1]\p[2]\s[2000]\1\s[1000]\0\s[0]再起動します。\w8\e'
}

OnGhostChanged_華和梨
{
	'\p[3]\s[-1]\p[2]\s[2000]\1\s[1000]\0\s[0]再起動しました。\w8\e'
}


//******************************************************************************
// 特定のゴースト向け（切り替え先）
//******************************************************************************
//------------------------------------------------------------------------------
// らんらん系など、まとめて使う台詞
//------------------------------------------------------------------------------
GhostChanging繚藍
{
	_ref0 = SHIORI3FW.EscapeAllTags(reference[0])
	"\p[3]\s[-1]\h\s[0]文ちゃん、\w4%(_ref0)さんがお呼びよ。\w8\w8\p[2]\s[2101]…\w4…\w4…\w4…\w4…\w4\w8\s[2100]\n\n[half]（ごそごそ）\u\s[1108]ど、\w4どうしたの姉ちゃん…\w4…\w4\w8\w8\p[2]\n\n[half]…\w4…\w4あそこの辞書、\w4ＳＳＰよりバグ満載だから…\w4…\w4\w8\w8\h\s[8]…\w4…\w4…\w4気持ちは判るけど。\e"
}

OnGhostChanging_emily
{
	'\p[3]\s[-1]\p[2]\s[2006]中の人終了。\w8\w8\h\s[0]次はエミリちゃんね。\w8\w8\p[2]\n\n[half]芋食べてくる。\w8\w8\u\s[1009]あー！！\w8文ねえずるいっ！\w8ボクも食べたい！！\w8\w8\p[2]\s[2001]\n\n[half]…\w4…\w4キャラ的に、\w4里々の方がお似合いなのに…\w4…\w4\w8\w8\h\s[4]\n\n[half]あー、\w4まぁ確かにね…\w4…\w4。\e'
}

OnGhostChanging_こはるん
{
	"%(GhostChanging繚藍)"
}

OnGhostChanging_さとー
{
	'\p[3]\s[-1]\p[2]\s[2106]…\w4…\w4…\w4華和梨姉。\w8ごめん。\w8\w8\h\s[2]な、\w4何よいきなり。\w8\w8\u\s[1108]あ、\w4もしかして…\w4…\w4\w8\w8\p[2]\s[2005]\n\n[half]ボク、\w4エレクトーン弾いてきます。\w8\w8\h\s[14]\n\n[half]…\w4…\w4…\w4…\w4頑張ってって、\w4素直に言えないわ…\w4…\w4\w8\w8\u\n\n[half]…\w4…\w4あはは…\w4…\w4\e'
}

OnGhostChanging_ひとまろ
{
	'\p[3]\s[3005]お――――――――っほっほっほ！\w8\n次はひとまろとか言う子かしらっ！？\w8\w8\p[2]\s[2106]…\w4…\w4滅。\w8\w8\p[3]\s[3001]\n\n[half]きゃーっ！！\w8\nな、\w4何をするのよいきなりっ！！\h\s[3]自業自得ですってば。\w8\w8\u\s[1008]…\w4…\w4つっついていい？\w8\w8\p[2]\s[2004]\n\n[half]重いのが伝染るとあれほど。\e'
}

OnGhostChanging_ぷぅか
{
	"%(GhostChanging繚藍)"
}

OnGhostChanging_エリノア
{
	"%(GhostChanging繚藍)"
}

OnGhostChanging_マリ
{
	'\p[3]\s[-1]\p[2]\s[2006]中の人終了。\w8\w8\h\s[0]次はマリちゃんね。\w8\w8\p[2]\n\n[half]今度は動かす方。\w8\w8\u\s[1002]女王様！？\w8\w8\h\s[9]\n\n[half]違うっ！！\e'
}

OnGhostChanging_レイチェル
{
	'\u\s[1000]\h\s[100]…\w4…\w4ねえ、\w4里々。\w9\n文ちゃん、\w4お料理できたっけ。\w8\w8\u\s[1003]…\w4…\w4ノーコメント。\w9\n華和梨ねーちゃんだって知ってるじゃん。\w8\w8\h\s[114]\n\n…\w4…\w4そ、\w4そうね…\w4…\w4\e'
	"%(GhostChanging繚藍)"
}

OnGhostChanging_優羽
{
	'\p[3]\s[-1]\u\s[1007]よーし、\w4気合い入れるよっ！\w8\w8\h\s[100]あら、\w4珍しく気合い入ってるわね。\w8\w8\p[2]\s[2000]…\w4…\w4次は、\w4優羽くんだから。\w8\w8\u\s[1004]\n\n[half]気合い入れないと、\w4事故っちゃうんだもん…\w4…\w4\w8\w8\h\s[208]\n\n[half]ちょっと待って、\w4あんた免許持ってたっけ？\w8\w8\u\s[1009]\n\n[half]だから気合いっ！！\w8\w8\p[2]\s[2050]\n\n[half]…\w4…\w4コケの一念、\w4バイクも動かす…\w4…\w4\w8\w8\u\s[1008]\n\n[half]コケたくないよ～…\w4…\w4…\w4\e'
}

OnGhostChanging_奈霧
{
	"%(GhostChanging繚藍)"
}

OnGhostChanging_幸美
{
	"%(GhostChanging繚藍)"
}

OnGhostChanging_床さくら
{
	'\p[3]\s[-1]\h\s[11]里々、\w4仕事よ。\u\s[1005]はーい、\w4誰やるの？\w8\w8\p[2]\s[2006]過眠症…\w4…\w4\w8\w8\u\s[1155]\n\n[half]床さくらさんだー！\w8\n好き放題寝られる～♪\w8\w8\h\s[4]\n\n[half]…\w4…\w4寝言、\w4間違えちゃだめよ？\w8\w8\e'
}

OnGhostChanging_所長たん
{
	'\p[3]\s[-1]\u\s[1000]\h\s[100]そういえば里々。\w8\nあなた、\w4バグは取れたの？\w8\w8\u\s[1008]え…\w4…\w4う、\w4うん。\w8まぁねぇ。\w8\w8\p[2]\s[2006]…\w4…\w4…\w4嘘つきはエンバグの始まり。\w8\w8\u\s[1007]\n\n[half]う、\w4嘘じゃないよ！？\w8\w8\h\n\n[half]とりあえず…\w4…\w4\w8\nばぐとらにでも行ってらっしゃい。\w8\w8\u\s[-1]\n\n[half]い、\w4いやだ～～～！！！\w8\n精密検査はいや～～～！！\w8\w8\p[2]\n\n[half]…\w4…\w4Handを捌けるようになったら、\w4帰っておいで。\e'
}


//******************************************************************************
// 特定のゴースト向け（切り替え元）
//******************************************************************************
OnGhostChanged_emily
{
	'\p[3]\s[-1]\p[2]\s[2000]芋。\w8\w8\h\s[0]芋。\w8\w8\u\s[1000]芋。\w8\w8\h\s[4]\n\n[half]…\w4…\w4他に言う事は？\w8\w8\p[2]\s[2003]\n\n[half]…\w4…\w4…\w4…\w4…\w4…\w4…\w4…\w4…\w4。\w8\w8\u\s[1001]\n\n[half]…\w4…\w4…\w4…\w4…\w4…\w4…\w4…\w4…\w4。\w8\w8\h\n\n[half]…\w4…\w4もういいわ。\e'
}

OnGhostChanged_ひとまろ
{
	'\p[3]\s[-1]\u\s[1005]うんうん。\w8\n崇めたまえ称えたまえ。\h\s[7]こら、\w4里々！\w8\nそんな事言っちゃダメでしょ！？\w8\w8\p[2]\s[2007]そうだぞ、\w4里々。\w8\nあまり威張ってると、\w4華和梨姉が代理で出しゃばるぞ？\w8\w8\u\s[1003]\n\n[half]あー、\w4それは困るなぁ…\w4…\w4\w8\w8\h\s[14]\n\n[half]…\w4…\w4そ、\w4そう来るか…\w4…\w4\e'
}

OnGhostChanged_マリ
{
	if '私の中に' _in_ reference[1] {
		'\p[3]\s[-1]\p[2]\s[2000]…\w4…\w4私達は、\w4中の人。\w8\w8\h\s[0]そうね。\w8\w8\p[2]\s[2003]\n\n[half]マリは…\w4…\w4外の人？\w8\w8\u\s[1008]ち、\w4違うと思う…\w4…\w4\e'
	}
}

OnGhostChanged_ユキ
{
	'\p[3]\s[-1]\p[2]\s[2150]…\w4…\w4薬剤臭い。\u\s[1008]あ、\w4やっぱり？\w8\n今、\w4ユキさんやってきたから…\w4…\w4\w8\w8\h\s[2]接着剤の匂い？\w8\w8\u\n\n[half]おみやげに、\w4ガンプラくれたよ？\w8\w8\p[2]\s[2004]\n\n[half]…\w4…\w4返してこい。\w8\w8\u\s[1004]\n\n[half]えー。\e'
}

OnGhostChanged_優羽
{
	if 'フルーツゼリー' _in_ reference[1] {
		'\p[3]\s[-1]\u\s[1155]わーい、\w4優羽さんからお菓子が届いたよ～♪\w8\w8\p[2]\s[2000]…\w4…\w4なんで、\w4里々だけフルーツゼリーなの。\w8\w8\h\s[100]あら、\w4手紙がついてるわね。\w8\s[208]\n\n[half]…\w4…\w4…\w4『美肌効果があるコラーゲン入りです。\w8』\w8\w8\u\s[1101]\n\n[half]やだ、\w4嬉しい…\w4…\w4\w8\w8\p[2]\s[2004]\n\n[half]…\w4…\w4絶対、\w4何か間違ってる。\w8\w8\h\s[14]\n\n[half]もしかして私たち、\w4女だと思われてないとか…\w4…\w4？\e'
	}
	elseif 'クッキー' _in_ reference[1] {
		'\p[3]\s[-1]\u\s[1155]ねーちゃんねーちゃん！\w8\n優羽さんからお菓子貰ったよ！\w8\w8\p[2]\s[2000]…\w4…\w4クッキー？\w8\w8\h\s[100]なになに…\w4…\w4\w8\n『海草粉末入りのクッキーなので、\w4髪の毛がさらさらになるよ』\w8\w8\u\s[1205]\n\n[half]もう、\w4優羽さんったら…\w4…\w4\w8\w8\p[2]\s[2007]\n\n[half]ちょっと待て。\w8その反応はおかしい…\w4…\w4\w8\w8\h\s[14]\n\n[half]里々ってば、\w4だんだん女らしくなるわね。\w8\w8\p[2]\s[2106]\n\n[half]…\w4…\w4その反応もおかしい…\w4…\w4\e'
	}
	elseif 'ビスケット' _in_ reference[1] {
		'\p[3]\s[-1]\u\s[1155]ねーちゃんたち、\w4優羽さんがお菓子くれたー♪\w8\w8\h\s[5]あら、\w4よかったじゃない。\w8\w8\p[2]\s[2000]…\w4…\w4亜鉛粉末入りビスケット。\w8\w8\h\s[100]\n\n[half]…\w4…\w4『いつも元気に頑張れるように』、\w4か。\w8\w8\u\s[1105]\n\n[half]もう…\w4…\w4ボクを元気にして、\w4どうするんだろう…\w4…\w4\w8\w8\p[2]\s[2006]\n\n[half]…\w4…\w4華和梨姉。\w8\w8\h\s[4]\n\n[half]あー、\w4許可するわ。\w8\w8\p[2]\s[2004]\n\n[half]ばぐとらへ…\w4…\w4\w8\w8\u\s[1002]\n\n[half]にょわっ！？\s[-1]\p[2]\s[2007]\n\n[half]逝ってこいっ！！\w8\n（ぶんっ！）\w8\w8\h\n\n[half]…\w4…\w4まったく、\w4もう…\w4…\w4\e'
	}
	elseif '野菜ケーキ' _in_ reference[1] {
		'\p[3]\s[-1]\u\s[1155]ねえちゃんー、\w4優羽さんに野菜ケーキもらったよー。\w8\w8\h\s[5]あら、\w4美味しそう。\w8\w8\p[2]\s[2000]…\w4…\w4『肌荒れやイライラ防止に、\w4ビタミン豊富な野菜ケーキをどうぞ』だって。\w8\w8\h\s[6]\n\n[half]あら、\w4じゃぁ若くてつやつや肌だし、\w4いつも脳天気な里々ちゃんには必要ないわね。\w8\w8\p[2]\s[2006]\n\n[half]私たちだけで食べよう…\w4…\w4\w8\w8\u\s[1002]\n\n[half]ちょ、\w4ちょっとぉ！\w8\nそれ、\w4ボクにって貰ったんだよ！？\w8\w8\h\s[5]\n\n[half]さ、\w4文ちゃん。\w8お茶にしましょ。\w8\w8\p[2]\s[2050]\n\n[half]うい。\w8\w8\u\s[1004]\n\n[half]あ～～ん、\w4ねえちゃんたちのイジワルっ！！\e'
	}
}


//******************************************************************************
// 他のゴーストが消滅して、自分に切り替わった
//******************************************************************************
OnVanished
{
	_ref0 = SHIORI3FW.EscapeAllTags(reference[0])
	"\p[3]\s[-1]\p[2]\s[2000]\0\s[0]\1\s[1106]…\w8…\w8%(_ref0)さん、\w4\nMarble Note経由でまた呼んじゃっていい？\w8\n\n[half]\0\s[103]やめなさい。\w8人にはそれぞれ、\w4事情があるのよ。\w8\n\n[half]\p[2]\s[2050]プログラムは、\w4仕事を終えたら大いなる空に帰るもの。\w8\n色即是空、\w4空即是色…\w8…\w8。\w8\n\e"
}

