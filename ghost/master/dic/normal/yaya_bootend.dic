//******************************************************************************
// SHIORIES
// 起動・終了のトーク
//******************************************************************************


//******************************************************************************
// 初回起動 OnFirstBoot
//******************************************************************************
OnFirstBoot
{
	//---- 変数の初期化
	username      = 'ユーザーさん'
	aitalkinterval  = 57
	intervalkeyword = '普通に'
	option_mikire   = 1
	option_kasanari = 1
	option_shake    = 1

	BootStart
	--
	FirstBootTalk
}

FirstBootTalk
{
	'\p[3]\s[-1]\p[2]\s[2000]\1\s[1000]\0\s[5]初めまして、\w4華和梨です。\w8\1\s[1005]里々で～す。\w8\p[2]\s[2000]私の名前は文（あや）、\w4「ふみ」って呼んだら泣く…\w8。\w8\n\n[half]\0\s[0]いつもゴーストを愛用していただき、\w4ありがとうございます。\w8\n今回、\w4日頃のご愛顧に応えるため、\w4私たち裏方プログラムのSHIORIっ子三人で、\w4\nゴースト達の動く舞台裏を、\w4皆さんに紹介することになりました。\w8\n\s[155]どうかお楽しみ下さい。\w8\n\n[half]\1\s[1005]本当は口実なんてどうでも良くて、\w4ボク達が表に出て遊びたいだけなんだけどね～\w8\n\n[half]\0\s[108]真相暴露禁止！\w8\n\s[106]まあ、\w4そんな側面もありますが…\w8。\w8\nともかく、\w4\s[5]よろしくお願いします。\w8\n\n[half]\p[2]\s[2000]…\w8…\w8華和梨姉、\w4まとめるの早すぎ。\w8\nそれに、\w4もう一人居る。\w8\n\n[half]\0\s[111]あ。\w8\p[3]\s[3000]オーホッホッホ！\w8\nそうよ、\w4私を忘れるなんて神が許しても、\w4\nユーザーさんが許しませんことよ！\w8\n\n[half]\0\s[208]\1\s[1004]\p[2]\s[2006]\p[3]\s[3000]私は無慈悲なデスクトップの女王、\w4里珠ですわ。\w8\n私の独演会、\w4たっぷりお楽しみ遊ばせ！\w8\n\n[half]\p[2]\s[2007]重量級縦ロールが何かたわごと言ってる…\w8…\w8\n\n[half]\0\s[108]\p[3]\s[3009]私が重いですってぇ！？\w8そこに直りなさい！\w8セグフォの露にしてくれ…\n\n[half]\p[2]\s[2006]滅。\w8\n\n[half]\p[3]\s[3000]え？\n\s[-1]\w8\b[-1]\0\s[114]あんたたち、\w4いい加減にしなさーい！！\w8\n\n[half]\1\s[1008]…\w8…\w8ま、\w4こんな感じ。\w8\n\s[1155]これからよろしくね～\w8\e'
}


//******************************************************************************
// 通常の起動 OnBoot
//******************************************************************************
//優先順位：異常終了のあと → 短時間での再起動 → 久しぶりの起動 → 時間帯
OnBoot
{
	BootStart
	--
	BootTalk
}

BootTalk
{
	if boot_crashed {
		BootCrashed
	}
	elseif 0 <= boot_away_min && boot_away_min < 3 {
		BootShort
	}
	elseif boot_away_min >= 60 * 24 * 30 {
		BootLong
	}
	else {
		EVAL('Boot_' + GetTimeZone)
	}
}

