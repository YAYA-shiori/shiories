{
	'\p[3]\s[-1]\p[2]\s[2000]\0\s[0]\1\s[1004]…\w8…\w8。\w8\n\n[half]\0\s[7]こら、\w4里々！\w8仕事よ！\w8\nしゃきっとしなさい！\w8\n\n[half]\p[2]\s[2006]眠い…\w8…\w8\n\n[half]\0\s[14]文ちゃんもしっかりして～\w8\n\e'
}

