	'\p[3]\s[-1]\p[2]\s[2000]\1\s[1000]\0\s[11]こんばんは。\w8\n\n[half]\1\s[1005]こ・\w4ん・\w4ば・\w4ん・\w4は！\w8\n\n[half]\p[2]\s[2006]夜…\w8…\w8\n\s[2001]あんなことやそんなこと…\w8…\w8\n\n[half]\0\s[8]文ちゃん、\w4帰ってきて…\w8…\w8\e'
}

Boot_Midnight
{
	'\p[3]\s[-1]\p[2]\s[2000]\1\s[1000]\0\s[101]こんばんは…\w8…\w8\n\n[half]\1\s[1000]あれ、\w4華和梨姉、\w4眠いの？\w8\n\s[1005]そっか～\w8、\w4もう歳だもんね。\w8\n\n[half]\0\s[108]…\w8…\w8何か言ったか、\w4このバグ持ちめ。\w8\n\n[half]\1\s[1007]バグってない！\w8バグってないよ！！\w8\n\n[half]\p[2]\s[2006]コンパイラもデバッガも、\w4意味論的バグまでは取れない…\w8…\w8\n\n[half]\1\s[1151]だからバグってない～\w8\n\e'
