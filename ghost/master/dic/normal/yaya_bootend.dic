//------------------------------------------------------------------------------
// 短時間での再起動（前回の終了から3分未満）
//------------------------------------------------------------------------------
BootShort
{
	'\p[3]\s[-1]\p[2]\s[2000]\0\s[0]\1\s[1003]早いのは嫌われるよ…\w8…\w8？\w8\n\n[half]\0\s[7]不穏な発言禁止！\w8\n\n[half]\p[2]\s[2006]…\w8…\w8\e'
}

//------------------------------------------------------------------------------
// 久しぶりの起動（前回の終了から30日以上）
//------------------------------------------------------------------------------
BootLong
{
	"\p[3]\s[-1]\p[2]\s[2000]\1\s[1000]\0\s[111]…\w8…\w8えーと、\w4どちら様でしたっけ？\w8\n\n[half]\1\s[1004]わーい、\w4華和梨姉がボケた～\w8\n\n[half]\0\s[114]\1\s[1005]えーと、\w4%(偽username)さんだよね！\w8\n\n[half]\p[2]\s[2002]\w8\w8\s[2004]…\w8…\w8%(username)、\w4久しぶり。\w8\e"
}

//------------------------------------------------------------------------------
// 前回、異常終了していた
//------------------------------------------------------------------------------
BootCrashed
{
	"\p[3]\s[-1]\p[2]\s[2000]\0\s[0]\1\s[1155]落ちたー！\w8\n\n[half]\0\s[14]落ちた…\w8…\w8\n\n[half]\1\s[1155]%(basewarename)が落ちたー！\w8\n\n[half]\p[2]\s[2050]…\w8…\w8私たちの責任かも？\w8\n\n[half]\1\s[1002]\0\s[2]\_s[0,1]！\w8\n\_s\e"
}


//******************************************************************************
// 終了 OnClose
//******************************************************************************
//優先順位：起動してすぐの終了 → 時間帯
//この部分には\eをつけないでね！（終了のタグ \- をあとで足します）
OnClose
{
	_up = GhostUpMinutes
	MarkClosed
	--
	CloseTalk(_up)
	--
	'\w9\w9\-\e'
}

CloseTalk
{
	if _argv[0] < 3 {
		CloseShort
	}
	else {
		EVAL('Close_' + GetTimeZone)
	}
}

