//******************************************************************************
// 終了 OnClose
//******************************************************************************
//優先順位：起動してすぐの終了 → 時間帯
//この部分には\eをつけないでね！（終了のタグ \- をあとで足します）
OnClose
{
	_up = GhostUpMinutes
	MarkClosed
	--
	CloseTalk(_up)
	--
	'\w9\w9\-\e'
}

CloseTalk
{
	if _argv[0] < 3 {
		CloseShort
	}
	else {
		EVAL('Close_' + GetTimeZone)
	}
}

