//******************************************************************************
// サイトが選ばれたとき
//******************************************************************************
OnRecommendsiteChoice
{
	_ref0 = SHIORI3FW.EscapeAllTags(reference[0])
	"\p[3]\s[-1]\p[2]\s[2000]\1\s[1000]\0\s[0]%(_ref0)のサイトです。\w8\e"
}

