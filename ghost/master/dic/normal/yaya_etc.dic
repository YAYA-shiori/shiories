//******************************************************************************
// ヘッドラインセンス
//******************************************************************************
OnHeadlinesenseBegin
{
	_name = SHIORI3FW.EscapeAllTags(reference[0])
	"%(HeadlineFace)%(_name) のヘッドラインを取得します。\w8\1\s[1005]どんなニュースかな♪\e"

	"%(HeadlineFace)%(_name) のヘッドラインを見に行きます。\w8\p[2]\s[2006]…\w8…\w8世間の様子見。\e"

	"%(HeadlineFace)\s[5]%(_name) のヘッドラインを取得しますね。\w8\n少しお待ちください。\e"
}

HeadlineFace
{
	'\p[3]\s[-1]\p[2]\s[2000]\1\s[1000]\0\s[0]'
}

//読み上げ。reference[2] … First / Next / Last / First and Last
OnHeadlinesense.OnFind
{
	_name = SHIORI3FW.EscapeAllTags(reference[0])
	if reference[2] == "First" || reference[2] == "First and Last" {
		"\0\b[2]\s[0]%(_name) ヘッドラインです。"
	}
	else {
		"\0\b[2]\s[0]%(_name) ヘッドラインの続きです。"
	}
	--
	"\n\n%(reference[3])\n"
	--
	if reference[2] == "First" || reference[2] == "Next" {
		AYATEMPLATE.MenuItem("次のページへ","OnHeadlinesenseNextPage")
		--
		AYATEMPLATE.MenuItem("読む",reference[1])
		--
		AYATEMPLATE.MenuItem("読まない","Menu_HeadlineCancel")
	}
	else {
		AYATEMPLATE.MenuItem("読む",reference[1])
		--
		AYATEMPLATE.MenuItem("読まない","Menu_HeadlineCancel")
	}
}

Menu_HeadlineCancel
{
	'\p[3]\s[-1]\p[2]\s[2000]\1\s[1000]\0\s[0]ヘッドラインは読みませんでした。\e'

	'\p[3]\s[-1]\p[2]\s[2000]\1\s[1000]\0\s[0]ヘッドラインは飛ばしますね。\w8\1\s[1003]読まないの～？\e'

	'\p[3]\s[-1]\p[2]\s[2000]\1\s[1000]\0\s[0]\p[2]\s[2006]…\w8…\w8見なかったことに。\e'
}

OnHeadlinesenseComplete
{
	'\p[3]\s[-1]\p[2]\s[2000]\1\s[1000]\0\s[0]ヘッドラインは更新されていませんでした。\w8\p[2]\s[2050]…\w8…\w8世は、\w4事もなし。\e'

	'\p[3]\s[-1]\p[2]\s[2000]\1\s[1000]\0\s[5]ヘッドラインを確認しましたが、\w4新しい情報はありませんでした。\w8\1\s[1004]つまんな～い。\e'

	'\p[3]\s[-1]\p[2]\s[2000]\1\s[1000]\0\s[0]ヘッドラインに更新はありません。\w8\1\s[1003]ニュースって、\w4毎日あるわけじゃないんだね。\w8\0\s[0]\n\n[half]更新が止まっているのかもしれないわよ。\e'
}

OnHeadlinesenseFailure
{
	if reference[0] == "can't download" {
		'\p[3]\s[-1]\p[2]\s[2000]\1\s[1000]\0\s[104]ヘッドライン情報が取得できませんでした。\w8\nネットワークの接続を確かめてください。\e'

		'\p[3]\s[-1]\p[2]\s[2000]\1\s[1000]\0\s[104]ヘッドライン情報の取得に失敗しました。\w8\1\s[1003]サイト、\w4お休みなのかな？\w8\p[2]\s[2006]…\w8…\w8定休日。\e'
	}
	elseif reference[0] == "can't analyze" {
		'\p[3]\s[-1]\p[2]\s[2000]\1\s[1000]\0\s[4]ヘッドライン情報の解析に失敗しました。\w8\nサイトの形式が変わったのかもしれません。\e'

		'\p[3]\s[-1]\p[2]\s[2000]\1\s[1000]\0\s[4]ヘッドライン情報を解析できませんでした…\w8…\w8。\w8\1\s[1003]読めない字でも書いてあったの？\w8\p[2]\s[2006]…\w8…\w8暗号。\e'
	}
	else {
		_err = SHIORI3FW.EscapeAllTags(reference[1])
		"\p[3]\s[-1]\p[2]\s[2000]\1\s[1000]\0\s[152]ヘッドラインで「%(_err)」というエラーが出ました。\w8\n何でしょう、\w4これ。\e"

		"\p[3]\s[-1]\p[2]\s[2000]\1\s[1000]\0\s[3]ヘッドラインの取得で「%(_err)」エラーです。\w8\1\s[1002]聞いたことないエラー！\w8\p[2]\s[2006]…\w8…\w8未知との遭遇。\e"
	}
}


//******************************************************************************
// スクリーンセーバーの終了
//******************************************************************************
//スクリーンセーバーが終わって、ユーザーが戻ってきたとき（開始は NOTIFY なので喋れない）
OnScreenSaverEnd
{
	ScreenSaverEndTalk
}

ScreenSaverEndTalk : nonoverlap
{
	"\p[3]\s[-1]\p[2]\s[2000]\1\s[1000]\0\s[0]\1\s[1002]あっ、\w4画面が戻った！\w8\w8\0\s[5]%(username)、\w4おかえりなさい。\w8\w8\p[2]\s[2050]…\w8…\w8お茶、\w4冷めた。\e"

	"\p[3]\s[-1]\p[2]\s[2000]\1\s[1000]\0\s[0]\1\s[1003]ねえねえ、\w4スクリーンセーバーの間って、\w4\nボクたちは何してればいいの？\w8\w8\0\s[100]静かに待つのよ。\w8\n%(username)が戻ってきたら、\w4すぐ話せるようにね。\w8\w8\p[2]\s[2006]…\w8…\w8待機は得意。\e"

	'\p[3]\s[-1]\p[2]\s[2000]\1\s[1000]\0\s[0]\p[3]\s[3000]ふん、\w4わたくしの舞台を隠すなんて、\w4\nスクリーンセーバーも生意気ですわね。\w8\w8\0\s[8]張り合わないでください、\w4里珠さん。\w8\w8\p[3]\s[3005]\n\n[half]おーっほっほっほ！\w8\e'
}


//******************************************************************************
// 壁紙の変更
//******************************************************************************
//OS 側で壁紙が変わったとき。reference[0] が update（起動後の変更）で、
//きっかけが user（ユーザーが変更）か theme（テーマの切り替え）のときだけ喋る。
//slideshow と spotlight は NOTIFY で喋れない。self（SSP 自身の変更）は
//OnWallpaperChange（yaya_legacy.dic）と二重にならないように除く
OnDesktopWallpaperChange
{
	if reference[0] == 'update' && (reference[1] == 'user' || reference[1] == 'theme') {
		DesktopWallpaperTalk
	}
}

DesktopWallpaperTalk : nonoverlap
{
	'\p[3]\s[-1]\p[2]\s[2000]\1\s[1000]\0\s[0]\1\s[1002]あっ、\w4壁紙が変わった！\w8\w8\0\s[153]背景が変わると、\w4私たちの見え方も変わるのよね。\w8\w8\p[2]\s[2006]…\w8…\w8保護色。\w8\w8\1\s[1008]\n\n[half]文姉ちゃん、\w4隠れる気だ…\w8…\w8\e'

	'\p[3]\s[-1]\p[2]\s[2000]\1\s[1000]\0\s[0]\p[3]\s[3000]あら、\w4壁紙を変えましたの？\w8\n新しい背景も、\w4わたくしが完璧に着こなして差し上げますわ！\w8\w8\p[2]\s[2006]…\w8…\w8背景は着ない。\w8\w8\p[3]\s[3009]\n\n[half]揚げ足を取らないでちょうだい！\w8\e'

	'\p[3]\s[-1]\p[2]\s[2000]\1\s[1000]\0\s[0]\s[5]壁紙が変わりましたね。\w8\n今度の背景も、\w4素敵です。\w8\w8\1\s[1105]ボクが映える色だといいな♪\w8\w8\p[2]\s[2006]…\w8…\w8緑なら、\w4落ち着く。\e'
}


//******************************************************************************
// 解像度の変更
//******************************************************************************
//画面の解像度や色深度が変わったとき（起動時は NOTIFY なので喋れない）。
//reference[0]=色深度、reference[1]=幅、reference[2]=高さ
OnDisplayChange
{
	DisplayChangeTalk
}

DisplayChangeTalk : nonoverlap
{
	"\p[3]\s[-1]\p[2]\s[2000]\1\s[1000]\0\s[0]\0\s[2]あら、\w4画面の解像度が変わったようです。\w8\n今は%(reference[1])×%(reference[2])ですね。\w8\w8\1\s[1002]うわ、\w4ちょっとチカチカした！\w8\w8\p[2]\s[2006]…\w8…\w8ちらつき、\w4確認。\e"

	"\p[3]\s[-1]\p[2]\s[2000]\1\s[1000]\0\s[0]\0\s[2]画面が%(reference[1])×%(reference[2])に変わりました。\w8\w8\p[2]\s[2006]…\w8…\w8お茶の置き場所が、\w4変わった。\w8\w8\1\s[1003]文姉ちゃん、\w4そこ気にするんだ…\w8…\w8\e"

	'\p[3]\s[-1]\p[2]\s[2000]\1\s[1000]\0\s[0]\1\s[1003]画面の大きさが変わったよ。\w8\nボクの居場所、\w4ちゃんと残ってるかな？\w8\w8\0\s[8]里々、\w4見切れてないか確認しなさい。\w8\w8\1\s[1005]\n\n[half]はーい♪\w8\n…\w8…\w8ちょっと右に寄せて…\w8…\w8\w8\w8\p[2]\s[2050]…\w8…\w8それ、\w4見切れてる。\e'
}

