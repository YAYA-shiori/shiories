//******************************************************************************
// ネットワークが重い
//******************************************************************************
OnNetworkHeavy
{
	'\p[3]\s[-1]\p[2]\s[2000]\0\s[0]\1\s[1004]回線重い～\w8。\w8\n華和梨姉、\w4ダイエットしないとダメだよ～\w8。\w8\n\n[half]\0\s[7]それとこれとは無関係だ無関係！！\w8\n\n[half]\p[2]\s[2050]…\w8…\w8\e'
}


//******************************************************************************
// 時計合わせ
//******************************************************************************
OnSNTPBegin
{
	"\0\s[0]ＳＮＴＰサーバ\n\n%(SHIORI3FW.EscapeAllTags(reference[0]))\n\nへのリクエストを開始します。\e"
}

//2008/03/25 19:15:05 のような形に整える
SNTPCompare_StrForm
{
	_txt = SPLIT(_argv[0],',')
	STRFORM('$04d/$02d/$02d $02d:$02d:$02d',TOINT(_txt[0]),TOINT(_txt[1]),TOINT(_txt[2]),TOINT(_txt[3]),TOINT(_txt[4]),TOINT(_txt[5]))
}

OnSNTPCompare
{
	"\_q\0\s[0]ＳＮＴＰ：%(SNTPCompare_StrForm(reference[1]))\nローカル：%(SNTPCompare_StrForm(reference[2]))\_q\n\n"
	--
	if TOINT(reference[3]) == 0 {
		'\0\s[0]まだズレてないみたいです。\e'
	}
	else {
		//\6は補正実行タグ。消しちゃだめ
		"\0\s[0]%(TOINT(reference[3]))秒ズレてるので修正します\6。\e"
	}
}

OnSNTPFailure
{
	'\0\s[4]ＳＮＴＰサーバへの接続に失敗しました。\e'
}


//******************************************************************************
// ヘッドラインセンス
//******************************************************************************
OnHeadlinesenseBegin
{
	_name = SHIORI3FW.EscapeAllTags(reference[0])
	"%(HeadlineFace)%(_name) ヘッドラインを取得します。\w8\e"
}

HeadlineFace
{
	'\p[3]\s[-1]\p[2]\s[2000]\1\s[1000]\0\s[0]'
}

//読み上げ。reference[2] … First / Next / Last / First and Last
OnHeadlinesense.OnFind
{
	_name = SHIORI3FW.EscapeAllTags(reference[0])
	if reference[2] == "First" || reference[2] == "First and Last" {
		"\0\b[2]\s[0]%(_name) ヘッドラインです。"
	}
	else {
		"\0\b[2]\s[0]%(_name) ヘッドラインの続きです。"
	}
	--
	"\n\n%(reference[3])\n"
	--
	if reference[2] == "First" || reference[2] == "Next" {
		AYATEMPLATE.MenuItem("次のページへ","OnHeadlinesenseNextPage")
		--
		AYATEMPLATE.MenuItem("読む",reference[1])
		--
		AYATEMPLATE.MenuItem("読まない","Menu_HeadlineCancel")
	}
	else {
		AYATEMPLATE.MenuItem("読む",reference[1])
		--
		AYATEMPLATE.MenuItem("読まない","Menu_HeadlineCancel")
	}
}

Menu_HeadlineCancel
{
	'\0ヘッドラインを読みませんでした。\e'
}

OnHeadlinesenseComplete
{
	'\p[3]\s[-1]\p[2]\s[2000]\1\s[1000]\0\s[0]ヘッドラインは更新されていませんでした。\w8\e'
}

OnHeadlinesenseFailure
{
	if reference[0] == "can't download" {
		'\p[3]\s[-1]\p[2]\s[2000]\1\s[1000]\0\s[104]ヘッドライン情報が取得できませんでした。\w8\e'
	}
	elseif reference[0] == "can't analyze" {
		'\p[3]\s[-1]\p[2]\s[2000]\1\s[1000]\0\s[4]ヘッドライン情報の解析に失敗しました。\w8\e'
	}
	else {
		"\p[3]\s[-1]\p[2]\s[2000]\1\s[1000]\0\s[152]「%(SHIORI3FW.EscapeAllTags(reference[1]))」エラー発生です。\w8\e"
	}
}

