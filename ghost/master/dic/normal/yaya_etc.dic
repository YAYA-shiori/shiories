//******************************************************************************
// 最小化から復帰（元の TalkRestore）
//******************************************************************************
//最小化された時刻を覚えておき、復帰したときに経過時間で振り分ける
//  5分未満＝Veryshort / 60分以上＝Long / それ以外＝通常
OnWindowStateMinimize
{
	minimize_sec = GETSECCOUNT
}

OnWindowStateRestore
{
	_min = 0
	if minimize_sec > 0 {
		_min = (GETSECCOUNT - minimize_sec) / 60
	}
	minimize_sec = 0
	if _min < 5 {
		Restore_Veryshort
	}
	elseif _min >= 60 {
		Restore_Long
	}
	else {
		Restore_Normal
	}
}

