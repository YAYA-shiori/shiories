OnBIFFComplete
{
	if TOINT(reference[0]) == 0 {
		'\p[3]\s[-1]\p[2]\s[2000]\1\s[1000]\0\s[5]新着なしでメールチェック完了です。\w8\e'
	}
	else {
		"\p[3]\s[-1]\p[2]\s[2000]\1\s[1000]\0\s[5]新着%(TOINT(reference[0]))通でメールチェック完了です。\w8\e"
	}
}

OnUpdateComplete
{
	if reference[0] != 'none' {
		MarkClosed
	}
	--
	'\p[3]\s[-1]\p[2]\s[2000]\1\s[1000]\0\s[5]ネットワーク更新完了です。\w8\e'
}


//******************************************************************************
// 最小化から復帰（元の TalkRestore）
//******************************************************************************
//最小化された時刻を覚えておき、復帰したときに経過時間で振り分ける
//  5分未満＝Veryshort / 60分以上＝Long / それ以外＝通常
OnWindowStateMinimize
{
	minimize_sec = GETSECCOUNT
}

OnWindowStateRestore
{
	_min = 0
	if minimize_sec > 0 {
		_min = (GETSECCOUNT - minimize_sec) / 60
	}
	minimize_sec = 0
	if _min < 5 {
		Restore_Veryshort
	}
	elseif _min >= 60 {
		Restore_Long
	}
	else {
		Restore_Normal
	}
}

Restore_Normal
{
	'\p[3]\s[-1]\p[2]\s[2000]\0\s[0]\1\s[1151]うーん、\w4狭い～\w8。\n華和梨姉、\w4太ったんじゃない？\w8\n\n[half]\0\s[7]太ってない！\w8太ってないから！\w8\n\e'
}

Restore_Veryshort
{
	'\p[3]\s[-1]\p[2]\s[2000]\0\s[0]\1\s[1000]…\w8…\w8\s[1003]あれ？\w8\e'
}

Restore_Long
{
	'\p[3]\s[-1]\p[2]\s[2000]\1\s[1000]\0\s[111]\1\s[1151]\p[2]\s[2101]\_s…\w8…\w8\_s\s[2004]\1\s[1004]\0\s[4]\_s[0,1,2]狭かった～\w8。\w8\n\_s\s[4]一応、\w4私たちも感覚あるんだけどなぁ。\w8\n\n[half]\1\s[1007]ひどいよ、\w4狭いし、\w4お姉ちゃん達はボクを触ってくるし\p[2]\s[2007]\0\s[7]\_s[0,2]触ってない！\w8ちゃんと！\w8\_s\e'
}


