//******************************************************************************
OnSNTPBegin
{
	_srv = SHIORI3FW.EscapeAllTags(reference[0])
	"\p[3]\s[-1]\p[2]\s[2000]\1\s[1000]\0\s[0]ＳＮＴＰサーバ\n\n%(_srv)\n\nへのリクエストを開始します。\e"

	"\p[3]\s[-1]\p[2]\s[2000]\1\s[1000]\0\s[0]時計合わせを始めます。\w8\nＳＮＴＰサーバ\n\n%(_srv)\n\nに時刻を聞いてみます。\w8\1\s[1003]ボク達の時計、\w4ずれてる？\e"

	"\p[3]\s[-1]\p[2]\s[2000]\1\s[1000]\0\s[0]時刻をＳＮＴＰサーバ\n\n%(_srv)\n\nに問い合わせます。\w8\p[2]\s[2006]…\w8…\w8時は金なり。\e"
}

//2008/03/25 19:15:05 のような形に整える
SNTPCompare_StrForm
{
	_txt = SPLIT(_argv[0],',')
	STRFORM('$04d/$02d/$02d $02d:$02d:$02d',TOINT(_txt[0]),TOINT(_txt[1]),TOINT(_txt[2]),TOINT(_txt[3]),TOINT(_txt[4]),TOINT(_txt[5]))
}

OnSNTPCompare
{
	"\p[3]\s[-1]\p[2]\s[2000]\1\s[1000]\_q\0\s[0]ＳＮＴＰ：%(SNTPCompare_StrForm(reference[1]))\nローカル：%(SNTPCompare_StrForm(reference[2]))\_q\n\n"
	--
	if TOINT(reference[3]) == 0 {
		'\0\s[0]まだズレてないみたいです。\e'

		'\0\s[5]時計は正確でした。\w8\1\s[1155]ばっちり～♪\e'

		'\0\s[5]ズレはありません。\w8\p[2]\s[2005]…\w8…\w8優秀。\e'
	}
	else {
		//\6は補正実行タグ。消しちゃだめ
		"\0\s[0]%(TOINT(reference[3]))秒ズレてるので修正します\6。\e"

		"\0\s[0]%(TOINT(reference[3]))秒ズレていたので、\w4時計を合わせます\6。\e"

		"\0\s[8]%(TOINT(reference[3]))秒もズレていました。\w8\1\s[1003]遅刻しちゃうよ～。\w8\p[2]\s[2006]…\w8…\w8修正します\6。\e"
	}
}

