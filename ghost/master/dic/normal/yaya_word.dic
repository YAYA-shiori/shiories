//華和梨の暗号化辞書に見せかけた、でたらめな英数字の列（引数は長さ。省略すると10）
偽暗号
{
	_n = 10
	if _argc > 0 {
		_n = TOINT(_argv[0])
	}
	_table = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz1234567890'
	_s = ''
	for _i = 0 ; _i < _n ; _i++ {
		_s += SUBSTR(_table,RAND(62),1)
	}
	_s
}

